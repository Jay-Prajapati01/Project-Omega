# Public build-time settings; only the anon/publishable key belongs here.
NEXT_PUBLIC_EXECUTION_MODE=local
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for absolute canonical URLs, sitemap.xml, and robots.txt in production.
# Set this to your real HTTPS domain after DNS and TLS are configured.
NEXT_PUBLIC_SITE_URL=
# Optional. GA4 loads only after a visitor accepts analytics consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Replace these before publishing the Privacy Notice.
NEXT_PUBLIC_PRIVACY_BUSINESS_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
