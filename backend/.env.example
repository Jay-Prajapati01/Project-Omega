# App
APP_NAME=MindMesh
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
DATA_DIR=/app/data

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=mindmesh

# Ollama
# ---- Low-RAM / CPU laptop defaults (recommended for 16 GB, no GPU) ----
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
#
# ---- High-end / GPU alternative (uncomment and pull these models) ----
# LLM_MODEL=qwen3:8b
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024
#
# NOTE: If you change EMBEDDING_DIM after already indexing content, you must
# recreate the Qdrant collection (delete the qdrant_storage volume), because
# the vector size is fixed at collection creation.

# AI backend (adaptive - see README "AI Backend Selection")
# Priority: GROQ_API_KEY -> HF_SPACE_URL -> local Ollama (default)
# GROQ_API_KEY=gsk_your_groq_key_here
# Cloud production default: openai/gpt-oss-20b. Local Ollama uses LLM_MODEL below.
# GROQ_MODEL=openai/gpt-oss-20b
# Optional independent failover requires XAI_API_KEY and an account-enabled model.
# LLM_FALLBACK_PROVIDER=xai
# XAI_FALLBACK_MODEL=
# Internal shared Redis safety budgets (80% of the sample Groq org quota).
# GROQ_SAFE_RPM=24
# GROQ_SAFE_RPD=800
# GROQ_SAFE_TPM=6400
# GROQ_SAFE_TPD=160000
# GROQ_CIRCUIT_FAILURE_THRESHOLD=5
# GROQ_CIRCUIT_OPEN_SECONDS=30
# LLM_USAGE_RETENTION_DAYS=90
# HF_SPACE_URL=https://your-space.hf.space

# Ingestion
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# Security hardening
SSRF_BLOCK_PRIVATE=true
MAX_JSON_BODY_SIZE=10485760
MAX_MULTIPART_BODY_SIZE=220200960
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW=60
RATE_LIMIT_READ_PER_MIN=120
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_POLL_PER_MIN=60
RATE_LIMIT_INGEST_PER_HOUR=20
RATE_LIMIT_CONTACT_PER_MIN=5
MAX_JOBS_PER_TENANT_PER_DAY=200
MAX_AI_REQUESTS_PER_TENANT_PER_DAY=500
MAX_UPLOAD_BYTES_PER_TENANT_PER_DAY=5368709120
# Required in production; use a managed Redis endpoint with TLS (rediss://).
# REDIS_URL=rediss://default:<password>@<host>:<port>
TRUST_PROXY=false
MAX_CONCURRENT_HEAVY_TASKS=2
MAX_PDF_PAGES=500
ZIP_MAX_UNCOMPRESSED_BYTES=524288000
ZIP_MAX_RATIO=200
FETCH_MAX_BYTES=20971520
FETCH_TIMEOUT_SECONDS=30

# Crawl4AI
CRAWL4AI_HEADLESS=true
CRAWL4AI_CACHE_MODE=bypass

# Instagram (optional - enables authenticated access to posts/reels)
# IG_USERNAME=your_instagram_username
# IG_PASSWORD=your_instagram_password


# Supabase auth (single project for auth, workspace membership and contact storage).
# Required for the Android companion app: without AUTH_ENABLED=true the API answers
# 503 AUTH_CONFIGURATION_REQUIRED on /api/mobile/* and the app can never upload a save.
# AUTH_ENABLED=true
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=<publishable/anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key, server-side only>
# SUPABASE_DB_URL=postgresql://postgres:<service role key>@db.<project>.supabase.co:5432/postgres?sslmode=require
# Prefer the Supabase transaction pooler for horizontally scaled API services.
# Pool size applies per process; account for all API and worker replicas.
# SUPABASE_DB_POOL_MAX_SIZE=5
# SUPABASE_DB_POOL_TIMEOUT_SECONDS=10
# BYOK / monetization: generate and set only in secret management. Never use
# the example values in production and never expose these in frontend builds.
BYOK_ENCRYPTION_KEY=
PROMO_HMAC_PEPPER=
OWNER_BOOTSTRAP_USER_ID=
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
