# Copy to backend.tf after creating a private, versioned S3 state bucket and
# DynamoDB lock table in your AWS account. Never commit a real state bucket name
# if your repository is public; this file is only a configuration template.
terraform {
  backend "s3" {
    bucket         = "replace-with-private-terraform-state-bucket"
    key            = "mindmesh/production/terraform.tfstate"
    region         = "ap-south-1"
    encrypt        = true
    dynamodb_table = "replace-with-terraform-lock-table"
  }
}
