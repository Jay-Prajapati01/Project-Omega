project_id                    = "replace-with-dedicated-project-id"
region                        = "asia-south1"
web_domain                    = "app.example.com"
api_domain                    = "api.example.com"
qdrant_url                    = "https://your-cluster.cloud.qdrant.io"
qdrant_collection             = "mindmesh_gemini_v1"
llm_provider                  = "groq"
llm_model                     = "openai/gpt-oss-20b"
enable_groq_secondary         = false
embedding_model               = "gemini-embedding-2"
embedding_dim                 = 768
deploy_services               = false
image_tag                     = "prod"
api_min_instances             = 2
api_max_instances             = 6
web_min_instances             = 1
web_max_instances             = 10
worker_max_concurrent_executions = 10
memorystore_memory_gb         = 1
waf_requests_per_ip_per_minute = 300
